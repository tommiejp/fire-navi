# Environment variable names only. Never commit real secret values.
# Set real values separately; this example does not configure an environment.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Trusted OAuth redirect origin (server only). For local work use http://localhost:3000.
APP_ORIGIN=https://fire-navi.vercel.app

# Server-only shared rate limit store (Vercel Upstash integration).
KV_REST_API_URL=
KV_REST_API_TOKEN=
